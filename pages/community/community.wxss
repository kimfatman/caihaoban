.community-header {
  background: #fff;
  padding: 20rpx 24rpx 12rpx;
}

.search-bar {
  border: 1rpx solid #ebedf0;
  background: #f7f8fa;
}

.search-label {
  font-size: 24rpx;
  color: #8a9099;
  margin-right: 12rpx;
}

.search-action {
  font-size: 26rpx;
  color: #1b6ef3;
  padding-left: 16rpx;
  border-left: 1rpx solid #e3e6eb;
}

.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.sort-tabs {
  display: flex;
  gap: 32rpx;
}

.sort-item {
  font-size: 28rpx;
  color: #4e5969;
  padding: 8rpx 0;
}

.sort-item.active {
  color: #1b6ef3;
  font-weight: 600;
}

.region-picker {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #4e5969;
}

.region-picker.active {
  color: #1b6ef3;
}

.category-scroll {
  background: #fff;
  white-space: nowrap;
  border-top: 1rpx solid #f2f3f5;
}

.chip {
  height: 56rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.community-tip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff8e8;
  color: #97600a;
  font-size: 23rpx;
  line-height: 1.6;
}

.community-count {
  padding: 18rpx 28rpx 10rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
}

.footer-holder {
  height: 140rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 44rpx;
  background: #1b6ef3;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 28rpx rgba(27, 110, 243, 0.32);
}
