<view class="page hall">
  <view class="hall-filter">
    <!-- 紧凑单行搜索：去掉左侧「搜索」文案，用途由占位提示说明 -->
    <view class="search-bar search-bar-compact">
      <input
        value="{{keyword}}"
        placeholder="搜索任务标题、服务区域"
        placeholder-class="placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <text class="search-action" bindtap="onSearch">查询</text>
    </view>

    <!-- 地区 / 业务类型同一行；更多筛选仍使用下方状态 chips（原入口不变） -->
    <view class="filter-row">
      <view class="filter-cell" bindtap="openRegion">
        <view class="filter-cell-inner {{city ? 'active' : ''}}">
          <text class="ellipsis">{{regionLabel}}</text>
          <view class="arrow"></view>
        </view>
      </view>
      <picker
        class="filter-cell"
        mode="selector"
        range="{{serviceOptions}}"
        value="{{serviceIndex}}"
        bindchange="onServiceChange"
      >
        <view class="filter-cell-inner {{serviceIndex > 0 ? 'active' : ''}}">
          <text class="ellipsis">{{serviceLabel}}</text>
          <view class="arrow"></view>
        </view>
      </picker>
      <view class="filter-reset" wx:if="{{hasFilter}}" bindtap="resetFilter">重置</view>
    </view>
  </view>

  <scroll-view class="status-scroll" scroll-x enable-flex>
    <view class="chips">
      <view
        class="chip {{status === item.value ? 'active' : ''}}"
        wx:for="{{statusList}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onStatusTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 公告牌入口：紧凑单行 Banner，沿用现有公告列表页与路由 -->
  <view class="notice-banner" bindtap="goNotice" hover-class="notice-banner-hover">
    <text class="notice-banner-icon">告</text>
    <text class="notice-banner-title">公告牌</text>
    <text class="notice-banner-sub ellipsis">业务合作 · 服务推广 · 资源对接</text>
    <view class="arrow"></view>
  </view>

  <view class="hall-summary" wx:if="{{!loading}}">
    <text class="hall-summary-text">共 {{total}} 个任务</text>
  </view>

  <block wx:if="{{list.length > 0}}">
    <task-card
      wx:for="{{list}}"
      wx:key="id"
      task="{{item}}"
      quotable="{{true}}"
      bind:tasktap="onTaskTap"
      bind:quote="onQuoteTap"
    />
  </block>

  <empty-state
    wx:elif="{{!loading}}"
    text="暂无符合条件的任务"
    tip="调整筛选条件试试，或发布一个新任务"
    btnText="发布任务"
    bind:action="goPublish"
  />

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="footer-holder"></view>
  <view class="fab" bindtap="goPublish">发布任务</view>

  <!-- 地区：省 / 市两级折叠选择 -->
  <view class="region-mask {{regionVisible ? 'show' : ''}}" bindtap="closeRegion"></view>
  <view class="region-panel {{regionVisible ? 'show' : ''}}" catchtap="noop">
    <view class="region-head">
      <text class="region-title">选择地区</text>
      <text class="region-clear" catchtap="clearRegion">不限地区</text>
    </view>

    <view class="region-hot-wrap">
      <text class="region-hot-label">热门城市</text>
      <scroll-view class="region-hot" scroll-x>
        <view class="region-hot-list">
          <view
            class="rh-item {{city === item ? 'active' : ''}}"
            wx:for="{{hotCities}}"
            wx:key="*this"
            data-city="{{item}}"
            catchtap="onHotCityTap"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="region-body">
      <scroll-view class="region-province" scroll-y scroll-with-animation scroll-into-view="pv{{activeProvinceIndex}}">
        <view
          id="pv{{index}}"
          class="rp-item {{activeProvince === item.name ? 'active' : ''}}"
          wx:for="{{regionTree}}"
          wx:key="name"
          data-name="{{item.name}}"
          catchtap="onProvinceTap"
        >{{item.short}}</view>
      </scroll-view>
      <scroll-view class="region-city" scroll-y scroll-with-animation>
        <view
          class="rc-item {{city === item ? 'active' : ''}}"
          wx:for="{{activeCities}}"
          wx:key="*this"
          data-city="{{item}}"
          catchtap="onCityTap"
        >
          <text class="rc-name ellipsis">{{item}}</text>
          <text class="rc-check" wx:if="{{city === item}}">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
