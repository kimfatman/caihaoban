<view class="page" wx:if="{{task}}">
  <view class="card task-summary">
    <view class="between">
      <text class="title ellipsis-2 flex1">{{task.title}}</text>
      <text class="tag {{task.stateTag}}">{{task.stateLabel}}</text>
    </view>
    <view class="row" style="gap:12rpx;margin-top:12rpx;">
      <text class="tag tag-plain">{{task.serviceTypeLabel}}</text>
      <text class="tag tag-plain">{{task.regionText}}</text>
    </view>
    <view class="kv mt16"><text class="k">参考价</text><text class="v price">{{task.referencePriceText}}</text></view>
    <view class="kv"><text class="k">报价截止</text><text class="v">{{task.quoteDeadlineText}}（{{task.countdown}}）</text></view>
    <view class="kv"><text class="k">期望完成</text><text class="v">{{task.expectedFinishText}}</text></view>
  </view>

  <view class="card" wx:if="{{editing && quote}}">
    <view class="between">
      <text class="muted">当前报价 V{{quote.versionCount}}</text>
      <text class="tag {{quote.statusTag}}">{{quote.statusLabel}}</text>
    </view>
    <view class="form-tip">修改后将生成新版本，历史版本会完整保留。</view>
  </view>

  <view class="form-group">
    <view class="form-item">
      <view class="form-label required">报价金额（元）</view>
      <input
        class="form-input amount-input"
        type="digit"
        value="{{form.amount}}"
        placeholder="请输入含税总价"
        placeholder-class="placeholder"
        data-field="amount"
        bindinput="onFieldInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label required">报价说明</view>
      <textarea
        class="form-textarea"
        value="{{form.remark}}"
        maxlength="500"
        placeholder="说明服务方案、人员投入、交付成果及不包含事项"
        placeholder-class="placeholder"
        data-field="remark"
        bindinput="onFieldInput"
      />
      <view class="form-tip">{{form.remark.length}}/500</view>
    </view>

    <view class="form-item">
      <view class="form-label required">预计完成时间</view>
      <picker mode="date" value="{{form.expectDate}}" start="{{today}}" bindchange="onDateChange">
        <view class="picker-value {{form.expectDate ? '' : 'empty'}}">
          <text>{{form.expectDate || '选择日期'}}</text>
          <view class="arrow"></view>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">费用包含范围</view>
      <textarea
        class="form-textarea short"
        value="{{form.feeInclude}}"
        maxlength="200"
        placeholder="如：含差旅、函证、报告工本费，不含银行开户费"
        placeholder-class="placeholder"
        data-field="feeInclude"
        bindinput="onFieldInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">代垫费用说明</view>
      <textarea
        class="form-textarea short"
        value="{{form.advanceFee}}"
        maxlength="200"
        placeholder="如：函证费约 600 元需先行代垫，凭票据实报实销"
        placeholder-class="placeholder"
        data-field="advanceFee"
        bindinput="onFieldInput"
      />
      <view class="form-tip">代垫费用属于费用记录的一部分，成交后需在订单中双方确认。</view>
    </view>

    <view class="form-item">
      <view class="form-label">报价附件</view>
      <view class="upload-grid">
        <view class="upload-item" wx:for="{{form.attachments}}" wx:key="name">
          <image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" />
          <text wx:else class="file-text">{{item.name}}</text>
          <view class="del" data-index="{{index}}" bindtap="removeAttachment">×</view>
        </view>
        <view class="upload-add" bindtap="chooseAttachment">
          <text class="plus">+</text>
          <text>添加附件</text>
        </view>
      </view>
    </view>
  </view>

  <view class="notice" style="margin-bottom:24rpx;">
    报价方默认不能查看其他报价金额；需求方接受报价后生成唯一订单，其他报价自动失效。
  </view>

  <view class="footer-holder"></view>
  <view class="footer-bar">
    <view class="btn btn-ghost" wx:if="{{editing && quote.status === 'pending'}}" bindtap="onWithdraw">撤回报价</view>
    <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : (editing ? '保存修改' : '提交报价')}}
    </view>
  </view>
</view>
