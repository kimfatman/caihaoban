<view class="page">
  <view class="tabs">
    <view
      class="tab {{tab === item.value ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{tab !== 'comment' && list.length > 0}}">
    <topic-card wx:for="{{list}}" wx:key="id" topic="{{item}}" showStatus="{{true}}" bind:topictap="onTopicTap" />
  </block>

  <block wx:if="{{tab === 'comment' && list.length > 0}}">
    <view class="comment-card" wx:for="{{list}}" wx:key="id" data-topic="{{item.topicId}}" bindtap="onCommentTap">
      <text class="comment-topic ellipsis">话题：{{item.topicTitle}}</text>
      <text class="comment-content">{{item.content}}</text>
      <view class="between">
        <text class="muted">赞 {{item.likeCount || 0}}</text>
        <text class="muted">{{item.createdAtText}}</text>
      </view>
    </view>
  </block>

  <empty-state
    wx:if="{{!loading && list.length === 0}}"
    text="暂无内容"
    tip="{{tab === 'topic' ? '发布话题与同行交流经验' : tab === 'comment' ? '参与话题讨论后会出现在这里' : '收藏的话题会出现在这里'}}"
    btnText="去同行交流"
    bind:action="goCommunity"
  />
</view>
