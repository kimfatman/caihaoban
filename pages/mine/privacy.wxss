.group-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-title {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  margin-bottom: 4rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.danger-text {
  color: #e54545;
}

.list-item {
  border-bottom: 1rpx solid #f2f3f5;
}

.list-item:last-child {
  border-bottom: none;
}

.tip {
  padding: 24rpx 32rpx;
  font-size: 22rpx;
  color: #8a9099;
  line-height: 1.7;
}

.logout {
  margin: 8rpx 24rpx 40rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #e54545;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
