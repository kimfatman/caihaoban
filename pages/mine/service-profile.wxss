.sp-head {
  background: #fff;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 20rpx;
}

.sp-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sp-head-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.sp-head-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b6ef3;
}

.sp-bar {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 5rpx;
  background: #eef1f5;
  overflow: hidden;
}

.sp-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: #1b6ef3;
  transition: width 0.2s ease;
}

.sp-head-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a9099;
}

.sp-head-link {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #1b6ef3;
}

/* 选项 chip：可换行，不挤压 */
.sp-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sp-chip {
  flex: 0 1 auto;
  max-width: 100%;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: #f5f6f8;
  color: #4e5969;
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  overflow: hidden;
}

.sp-chip.active {
  background: #eaf1fe;
  color: #1b6ef3;
  font-weight: 500;
}

.sp-chip-del {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #1b6ef3;
}

.sp-add {
  margin-top: 16rpx;
  height: 60rpx;
  border-radius: 30rpx;
  border: 1rpx dashed #c9d4e6;
  color: #1b6ef3;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a9099;
}

/* 地区选择面板 */
.region-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.region-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.region-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(101%);
  transition: transform 0.25s ease;
}

.region-panel.show {
  transform: translateY(0);
}

.region-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx 16rpx;
}

.region-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.region-clear {
  font-size: 25rpx;
  color: #8a9099;
}

.region-form {
  border-top: 1rpx solid #f2f3f5;
}

.region-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.region-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 26rpx;
  color: #8a9099;
}

.region-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.region-actions .btn {
  flex: 1;
}
