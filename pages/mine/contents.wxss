.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #4e5969;
  position: relative;
}

.tab.active {
  color: #1b6ef3;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1b6ef3;
}

.comment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.comment-topic {
  font-size: 24rpx;
  color: #1b6ef3;
  max-width: 100%;
}

.comment-content {
  font-size: 27rpx;
  color: #1f2329;
  line-height: 1.6;
}
