.block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #4e5969;
}

.fee-row.total {
  border-top: 1rpx dashed #ebedf0;
  margin-top: 8rpx;
  padding-top: 20rpx;
  font-weight: 600;
  color: #1f2329;
}

.record-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-item:last-child {
  border-bottom: none;
}

.diff {
  font-size: 26rpx;
  font-weight: 600;
  color: #e54545;
}

.confirm-line {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}

.confirm-tag {
  font-size: 22rpx;
  color: #8a9099;
  background: #f5f6f8;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.confirm-tag.ok {
  color: #12b76a;
  background: #e8f8ef;
}

.confirm-tag.no {
  color: #e54545;
  background: #fdecec;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.record-actions .btn {
  flex: none;
  padding: 0 28rpx;
}

.empty-line {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b7bcc4;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8a9099;
}
