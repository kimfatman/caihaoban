.task-summary {
  margin-bottom: 20rpx;
}

.task-summary .title {
  font-size: 28rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f2f3f5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #4e5969;
  position: relative;
}

.tab.active {
  color: #1b6ef3;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1b6ef3;
}
