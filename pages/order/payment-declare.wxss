.type-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 10rpx;
  background: #f5f6f8;
  color: #4e5969;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.type-btn.active {
  background: #eaf1fe;
  color: #1b6ef3;
  font-weight: 500;
  border: 1rpx solid #1b6ef3;
}

.amount-input {
  font-size: 44rpx;
  font-weight: 600;
  color: #ff6a00;
  height: 80rpx;
  line-height: 80rpx;
}

.form-item {
  border-bottom: none;
  margin-bottom: 20rpx;
}
