.loading-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx 24rpx;
}

.chat-tip {
  padding: 16rpx 20rpx;
  margin: 20rpx 0 8rpx;
  border-radius: 12rpx;
  background: #fff8e8;
  color: #97600a;
  font-size: 22rpx;
  line-height: 1.6;
}

.chat-biz {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  margin: 20rpx 0 8rpx;
  background: #fff;
  border-radius: 16rpx;
}

.chat-biz-label {
  display: block;
  font-size: 20rpx;
  color: #b7bcc4;
  margin-bottom: 4rpx;
}

.chat-biz-subject {
  display: block;
  font-size: 26rpx;
  color: var(--text);
}

.chat-biz-more {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary);
}

.chat-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.chat-time {
  text-align: center;
  font-size: 20rpx;
  color: #b7bcc4;
  padding: 20rpx 0 0;
}

.chat-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 24rpx;
}

/* 连续消息收紧间距，不使用负边距 */
.chat-row.continued {
  margin-top: 8rpx;
}

.chat-row.mine {
  flex-direction: row-reverse;
}

/* 固定头像列宽，合并头像后气泡左边界保持一致 */
.chat-avatar {
  flex-shrink: 0;
  width: 72rpx;
}

/* 预留头像列（72）+ 间距（16）后仍有余量，保证气泡不贴边 */
.bubble-wrap {
  min-width: 0;
  max-width: calc(100% - 120rpx);
}

.bubble {
  display: inline-block;
  max-width: 100%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  font-size: 28rpx;
  line-height: 44rpx;
  color: var(--text);
  text-align: left;
  /* 中英文数字混排：优先按词换行，超长串再强制断行 */
  word-break: break-word;
  overflow-wrap: break-word;
}

.chat-row.mine .bubble {
  background: var(--primary);
  color: #fff;
}

.bubble-image {
  width: 260rpx;
  max-width: 100%;
  border-radius: 16rpx;
  display: block;
}

.chat-anchor {
  height: 8rpx;
}

.quick-bar {
  background: #fff;
  border-top: 1rpx solid var(--line);
}

.quick-list {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.quick-item {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f6f8;
  color: var(--text-2);
  font-size: 24rpx;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.icon-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f5f6f8;
  color: var(--text-2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: #d8e3f8;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.active {
  background: var(--primary);
}
