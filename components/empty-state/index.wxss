.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef0f3;
  color: #b7bcc4;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8a9099;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b7bcc4;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 32rpx;
  height: 68rpx;
  padding: 0 40rpx;
  border-radius: 34rpx;
  background: #1b6ef3;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}
